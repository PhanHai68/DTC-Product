  "series": [
    {
      "seriesCode": "ASST_VIBRO",
      "displayCode": "ASST",
      "nameVi": "Máy sàng rung tròn hiệu suất cao",
      "nameEn": "ASST Series High Efficient Sifting Machine",
      "pdfPages": "22",
      "image": "assets/images/catalog_sifter_vibro.png",
      "imageCaption": "Ảnh đại diện dòng ASST",
      "applicationVi": "Phân loại cỡ hạt nguyên liệu bột khô trong ngành dược phẩm, hóa chất, thực phẩm...",
      "structureVi": "- Động cơ rung thẳng đứng\n- Đáy sàng\n- Khung lưới\n- Buồng sàng\n- Bát rung cao su\n- Các chi tiết bắt chặt",
      "workingPrincipleVi": "Động cơ rung thẳng đứng tạo dao động cho buồng sàng (1500 lần/phút); nguyên liệu được phân loại theo cỡ hạt qua lưới sàng.\nCó thể dùng 1 lớp lưới hoặc nhiều lớp lưới để tách nhiều cỡ hạt.",
      "featuresVi": "1. Kết cấu gọn: dễ vận hành và sửa chữa.\n2. Chạy êm: độ ồn thấp.\n3. Năng suất lớn: độ mịn tốt.\n4. Ứng dụng rộng: lưới 12 - 200 mesh."
    },
    {
      "seriesCode": "ASRS_ROTARY",
      "displayCode": "ASRS",
      "nameVi": "Máy sàng quay",
      "nameEn": "ASRS Series Rotary Sifter",
      "pdfPages": "23",
      "image": "assets/images/catalog_sifter_rotary.png",
      "imageCaption": "Ảnh đại diện dòng ASRS",
      "applicationVi": "Sàng nguyên liệu dạng hạt rắn; dùng kèm dây chuyền xử lý bột hoặc chạy độc lập. Phù hợp sàng nguyên liệu có độ nhớt cao, nhiều xơ trong ngành dược phẩm, hóa chất, thực phẩm.",
      "structureVi": "- Đế máy và khung máy\n- Cơ cấu vít cấp liệu vào / ra\n- Động cơ\n- Lồng sàng đặt trong xi lanh, có cánh gạt",
      "workingPrincipleVi": "Trong xi lanh có lồng sàng; cánh gạt liên tục đảo nguyên liệu lên xuống và đẩy về phía trước.\nHạt mịn lọt qua lưới sàng; phần hạt thô tiếp tục được đẩy đi và ra ở cửa xả hạt thô.",
      "featuresVi": "1. Nguyên liệu khó sàng: phù hợp nguyên liệu độ nhớt cao, nhiều xơ.\n2. Linh hoạt: dùng kèm dây chuyền bột hoặc chạy độc lập.\n3. Tách 2 cửa ra: hạt mịn và hạt thô.\n4. Lưới sàng: 20 - 200 mesh."
    }
  ],
